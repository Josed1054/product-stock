# Usa la API mock interna (1/0). En dev se recomienda 1.
NEXT_PUBLIC_USE_MOCK_API=1

# URL base del backend real (solo si NEXT_PUBLIC_USE_MOCK_API=0)
# Ejemplo: http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=
VITE_API_BASE_URL=

# Secreto para firmar/verificar JWT en la API mock (solo server-side)
# Cambia este valor si vas a desplegar la API mock.
MOCK_JWT_SECRET=change-me
